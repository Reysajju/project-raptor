// Raptor Portal — Prisma schema
// SQLite-backed. Access control is enforced in API route handlers.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id          String   @id @default(cuid())
  email       String   @unique
  fullName    String
  role        String   @default("admin") // owner | admin | client
  avatarUrl   String?
  clientId    String?  // set for client users
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client      Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)

  ownedClients     Client[]    @relation("ClientOwner")
  assignedComms    Communication[] @relation("CommAssignee")
  assignedTasks    Task[]      @relation("TaskAssignee")
  uploads          FileItem[]  @relation("FileUploader")
  approvalsDecided Approval[]  @relation("ApprovalDecider")
  auditActions     AuditLog[]  @relation("AuditActor")
  notifications     Notification[]
}

model Client {
  id           String   @id @default(cuid())
  name         String
  company      String?
  status       String   @default("active") // active | prospect | churned | paused
  tags         String   @default("") // comma-separated
  ownerId      String?
  customFields String   @default("{}") // JSON string
  notes        String   @default("")
  accentColor  String   @default("violet")
  logoUrl      String?
  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  owner        Profile?       @relation("ClientOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  contacts     ClientContact[]
  communications Communication[]
  projects     Project[]
  files        FileItem[]
  approvals    Approval[]
  forms        Form[]
  formResponses FormResponse[]
  clientUsers  Profile[]
}

model ClientContact {
  id              String   @id @default(cuid())
  clientId        String
  type            String   // email | phone
  value           String   // raw
  valueNormalized String   // lowercase email or E.164 phone
  label           String   @default("") // work | personal | mobile ...
  isPrimary       Boolean  @default(false)
  createdAt       DateTime @default(now())

  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([type, valueNormalized])
  @@index([clientId])
}

model Communication {
  id                 String   @id @default(cuid())
  clientId           String?
  channel            String   // email | sms | call | portal | note | system
  direction         String   // inbound | outbound | internal
  provider           String   @default("manual") // gmail | openphone | ringcentral | portal | manual
  providerMessageId  String?
  threadKey          String?
  subject            String   @default("")
  bodyText           String   @default("")
  bodyHtmlSanitized  String   @default("")
  summary            String?
  transcript         String?
  audioUrl           String?
  durationSec        Int?
  fromValue          String   @default("")
  toValue            String   @default("")
  status             String   @default("open") // open | snoozed | done
  assignedTo         String?
  visibleToClient     Boolean  @default(false)
  occurredAt         DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  client             Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  assignee           Profile? @relation("CommAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)
  attachments        Attachment[]

  @@index([clientId, occurredAt])
  @@index([status])
  @@index([channel])
  @@index([provider, providerMessageId])
}

model Attachment {
  id              String   @id @default(cuid())
  communicationId String
  clientId        String?
  fileName        String
  mimeType        String
  sizeBytes       Int
  storagePath     String   // relative path under /public/mock-storage or a URL
  createdAt       DateTime @default(now())

  communication   Communication @relation(fields: [communicationId], references: [id], onDelete: Cascade)
}

model Project {
  id         String   @id @default(cuid())
  clientId   String
  title      String
  status     String   @default("planning") // planning | active | review | done | paused
  stage      String   @default("To Do")
  dueDate    DateTime?
  position   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  milestones Milestone[]
  tasks      Task[]
  files      FileItem[]
  approvals  Approval[]

  @@index([clientId])
  @@index([status])
}

model Milestone {
  id         String   @id @default(cuid())
  projectId  String
  title      String
  dueDate    DateTime?
  completed   Boolean  @default(false)
  position   Int      @default(0)

  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Task {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  status      String   @default("todo") // todo | in_progress | review | done
  assigneeId  String?
  dueDate     DateTime?
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee    Profile? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
}

model FileItem {
  id             String   @id @default(cuid())
  clientId       String
  projectId      String?
  folder         String   @default("General")
  fileName       String
  storagePath    String
  mimeType       String
  sizeBytes      Int
  version        Int      @default(1)
  uploadedById   String?
  sharedWithClient Boolean @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project        Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  uploader       Profile? @relation("FileUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  approvals      Approval[]

  @@index([clientId])
}

model Approval {
  id         String   @id @default(cuid())
  clientId   String
  projectId  String?
  fileId      String?
  title      String
  status     String   @default("pending") // pending | approved | changes_requested
  decidedById String?
  decidedAt  DateTime?
  comment    String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project    Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  file       FileItem? @relation(fields: [fileId], references: [id], onDelete: SetNull)
  decider    Profile? @relation("ApprovalDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([clientId, status])
}

model Form {
  id         String   @id @default(cuid())
  clientId   String?
  title      String
  description String   @default("")
  schemaJson String   @default("[]") // JSON array of field definitions
  status     String   @default("draft") // draft | published | archived
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client     Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  responses  FormResponse[]
}

model FormResponse {
  id         String   @id @default(cuid())
  formId     String
  clientId   String?
  answersJson String  @default("{}")
  status     String   @default("submitted") // submitted | reviewed
  submittedAt DateTime @default(now())

  form       Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  client     Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([formId])
}

model Notification {
  id         String   @id @default(cuid())
  userId     String
  type       String
  title      String
  body       String   @default("")
  payloadJson String  @default("{}")
  readAt     DateTime?
  createdAt  DateTime @default(now())

  user       Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model IntegrationCredential {
  id         String   @id @default(cuid())
  provider   String   @unique // gmail | openphone | ringcentral
  status     String   @default("disconnected") // connected | disconnected | error
  accountLabel String @default("")
  lastSyncAt DateTime?
  watchExpiresAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model WebhookEvent {
  id         String   @id @default(cuid())
  provider   String
  eventId    String
  eventType  String   @default("")
  rawJson    String   @default("{}")
  status     String   @default("received") // received | processed | failed
  attempts   Int      @default(0)
  error      String?
  receivedAt DateTime @default(now())

  @@unique([provider, eventId])
  @@index([status])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entity     String
  entityId   String?
  metadataJson String  @default("{}")
  createdAt  DateTime @default(now())

  actor      Profile? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([createdAt])
}

// ============================================================
// Auth & User Accounts
// ============================================================

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  fullName    String?
  role        String   @default("member") // owner | admin | member
  avatarUrl   String?
  isDemo      Boolean  @default(false)
  lastLoginAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  magicLinks  MagicLinkToken[]
  sessions    Session[]

  @@index([email])
}

model MagicLinkToken {
  id          String   @id @default(cuid())
  token       String   @unique
  email       String   // the email the link was sent to
  userId      String?  // resolved user (null if new signup)
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([email])
}

model Session {
  id          String   @id @default(cuid())
  token       String   @unique
  userId      String
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

// ============================================================
// Third-party integrations: Email accounts & Google Drive
// ============================================================

model EmailAccount {
  id          String   @id @default(cuid())
  email       String
  type        String   // gmail | custom | outlook
  displayName String?
  // For Gmail: stores the OAuth scopes available. For custom domains:
  // stores IMAP/SMTP config (server, port, encryption).
  configJson  String   @default("{}")
  isActive    Boolean  @default(true)
  connectedAt DateTime @default(now())
  lastSyncAt  DateTime?
  userId      String?

  @@index([email])
}

model DriveConnection {
  id          String   @id @default(cuid())
  provider    String   @default("google_drive")
  folderUrl   String   // the shared folder link
  folderName  String?
  isActive    Boolean  @default(true)
  connectedAt DateTime @default(now())
  lastSyncAt  DateTime?
  userId      String?

  @@index([provider])
}
